# Confluent Cloud
CONFLUENT_BOOTSTRAP_SERVERS=your-cluster.region.aws.confluent.cloud:9092
CONFLUENT_API_KEY=your_api_key
CONFLUENT_API_SECRET=your_api_secret

# Kafka topic to produce race events into
KAFKA_TOPIC=race-events

# MQTT broker (on the Windows machine, this stays as localhost)
MQTT_HOST=localhost
MQTT_PORT=1883

# Docker Hub
DOCKER_IMAGE=your_dockerhub_username/race-api

# IBM Code Engine
CE_PROJECT=your-code-engine-project-name
CE_RESOURCE_GROUP=your-resource-group
CE_REGION=us-south

# WatsonX Orchestrate
WXO_ENV=RACE
WXO_URL=https://api.us-south.watson-orchestrate.cloud.ibm.com/instances/your_instance_id
